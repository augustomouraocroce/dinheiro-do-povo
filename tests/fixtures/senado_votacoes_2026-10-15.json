[{"ano": 2026, "casaSessao": "SF", "codigoMateria": 175969, "codigoSessao": 591273, "codigoSessaoLegislativa": 874, "codigoSessaoVotacao": 7108, "dataApresentacao": "2026-10-14", "dataSessao": "2026-10-15", "descricaoVotacao": "Votação nominal do Projeto de Lei Complementar nº 186, de 2026, nos termos do parecer.", "ementa": "Altera a Lei Complementar nº 123, de 14 de dezembro de 2006, para atualizar o limite de receita bruta anual e o número de empregados do Microempreendedor Individual (MEI), conceder remissão de créditos de titularidade da União de sua responsabilidade e dispor sobre a aplicação da medida.", "idProcesso": 9114338, "identificacao": "PLP 186/2026", "informeLegislativo": {"casaColegiado": "SF", "casaEnteAdm": "SF", "codigoColegiado": 1998, "data": "2026-10-15", "id": 2319848, "idEnteAdm": 13594, "idEvento": 11393353, "nomeColegiado": "Plenário do Senado Federal", "nomeEnteAdm": "Secretaria de Atas e Diários", "numeroAutuacao": 1, "siglaColegiado": "PLEN", "siglaEnteAdm": "SEADI", "texto": "(Sessão Deliberativa Ordinária - semipresencial - de 15 de outubro de 2026)  \nUrgência aprovada para a matéria (Requerimento nº 715/2026 encaminhado à publicação). \nEmenda nº 1-Plen encaminhada à publicação. \nParecer nº 208/2026-Plen/SF apresentado pelo Senador Carlos Fávaro e encaminhado à publicação (favorável ao projeto, com a Emenda nº 2, de redação, que apresenta, e contrário à Emenda nº 1). \nDiscussão da matéria encerrada. \nProjeto aprovado com a Emenda nº 2, de redação (Sim: 78; Presidente: 1; Total: 79). \nParecer nº 209/2026-Plen/SF, da Comissão Diretora, com a redação final, encaminhado à publicação. \nRedação final aprovada. \nA matéria vai à sanção. \nA Câmara dos Deputados será comunicada. "}, "numero": "186", "numeroSessao": 135, "resultadoVotacao": "A", "sequencialSessao": 1, "sequencialVotacao": 4422, "sigla": "PLP", "siglaTipoSessao": "DOR", "totalVotosAbstencao": null, "totalVotosNao": null, "totalVotosSim": null, "votacaoSecreta": "N", "vot