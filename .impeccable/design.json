  "components": [
    {
      "name": "Price Tag (etiqueta)",
      "kind": "custom",
      "refersTo": "etiqueta",
      "description": "Cost as a shelf price tag with superscript currency and cents; the largest object in its frame, sized by container query inside the price block.",
      "html": "<div class=\"ds-preco-bloco\"><span class=\"ds-etiqueta\" aria-label=\"R$ 233.591,45\"><span class=\"ds-moeda\">R$</span><span>233.591</span><span class=\"ds-cent\">,45</span></span><span class=\"ds-sob\">por mês</span><span class=\"ds-sm\">= 144 salários mínimos</span></div>",
      "css": ":host{--amarelo:#ffd60a;--tinta:#111111;--tinta-2:#3d3d3d;--papel:#ffffff;--papel-2:#f6f5f0;--linha:#dedbd0;--carimbo:#1e40af;--verde:#12803f;--vermelho:#c81e1e;font-family:Archivo,system-ui,sans-serif;}.ds-preco-bloco{container-type:inline-size;display:grid;gap:6px;justify-items:start;background:var(--papel);padding:16px;border:2px solid var(--tinta);border-radius:10px;max-width:420px}.ds-etiqueta{display:inline-flex;align-items:flex-start;width:100%;background:var(--amarelo);border:3px solid var(--tinta);border-radius:9px;padding:8px 14px 6px 12px;font-stretch:62%;font-weight:900;line-height:.86;letter-spacing:-.015em;white-space:nowrap;font-size:clamp(3rem,21cqi,6.6rem);color:var(--tinta)}.ds-moeda{font-size:.46em;margin:.1em .12em 0 0}.ds-cent{font-size:.38em;margin:.08em 0 0 .04em}.ds-sob{font-stretch:70%;font-weight:800;font-size:1.35rem;line-height:1.1}.ds-sm{font-size:.875rem;font-weight:650;color:var(--tinta-2)}"
    },
    {
      "name": "Source Stamp (carimbo)",
      "kind": "custom",
      "refersTo": "carimbo",
      "description": "Blue rubber-stamp link to the official source of a number.",
      "html": "<a class=\"ds-carimbo\" href=\"#\">Fonte: Câmara dos Deputados<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 4h6v6M20 4l-9 9\"/><path d=\"M18 14v5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 19V7.5A1.5 1.5 0 0 1 5.5 6H10\"/></g></svg></a>",
      "css": ":host{--amarelo:#ffd60a;--tinta:#111111;--tinta-2:#3d3d3d;--papel:#ffffff;--papel-2:#f6f5f0;--linha:#dedbd0;--carimbo:#1e40af;--verde:#12803f;--vermelho:#c81e1e;font-family:Archivo,system-ui,sans-serif;}.ds-carimbo{display:inline-flex;align-items:center;gap:6px;color:var(--carimbo);border:2.5px solid var(--carimbo);border-radius:7px;padding:3px 10px;font-stretch:75%;font-weight:750;font-size:.95rem;line-height:1.25;text-decoration:none;transform:rotate(-2deg);background:rgba(255,255,255,.6);transition:background-color .15s ease,color .15s ease}.ds-carimbo:hover{background:var(--carimbo);color:var(--papel)}.ds-carimbo:focus-visible{outline:3px solid var(--carimbo);outline-offset:2px}.ds-carimbo svg{width:15px;height:15px}"
    },
    {
      "name": "Tile (ladrilho)",
      "kind": "card",
      "refersTo": "ladrilho",
      "description": "White content tile outlined in 2px ink on the yellow field.",
      "html": "<div class=\"ds-campo\"><section class=\"ds-ladrilho\"><h3>De onde vem esse custo</h3><p>O salário bruto é só uma parte. A maior parte é a verba de gabinete.</p><span class=\"ds-ev\">média calculada a partir das páginas oficiais</span></section></div>",
      "css": ":host{--amarelo:#ffd60a;--tinta:#111111;--tinta-2:#3d3d3d;--papel:#ffffff;--papel-2:#f6f5f0;--linha:#dedbd0;--carimbo:#1e40af;--verde:#12803f;--vermelho:#c81e1e;font-family:Archivo,system-ui,sans-serif;}.ds-campo{background:var(--amarelo);padding:16px}.ds-ladrilho{background:var(--papel);border:2px solid var(--tinta);border-radius:10px;padding:22px;display:grid;gap:12px;color:var(--tinta)}.ds-ladrilho h3{margin:0;font-stretch:68%;font-weight:850;font-size:1.35rem;line-height:1.02}.ds-ladrilho p{margin:0;font-size:17px;line-height:1.5;max-width:68ch}.ds-ev{font-size:.875rem;font-weight:650;color:#5b4a00}"
    },
