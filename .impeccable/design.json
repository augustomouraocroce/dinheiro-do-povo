      "html": "<nav class=\"ds-nav\"><a aria-current=\"page\" href=\"#\"><svg viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linejoin=\"round\"><path d=\"M3 11 12 3.5 21 11\"/><path d=\"M5.5 9.5V20h5v-6h3v6h5V9.5\"/></g></svg>Início</a><a href=\"#\"><svg viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"M15.5 15.5 21 21\"/></g></svg>Buscar</a><a href=\"#\"><svg viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"8\" cy=\"8\" r=\"3.2\"/><circle cx=\"16.5\" cy=\"9\" r=\"2.6\"/><path d=\"M2.5 20c.6-3.6 2.8-5.6 5.5-5.6s4.9 2 5.5 5.6\"/><path d=\"M14.2 14.6c.7-.3 1.4-.5 2.3-.5 2.3 0 4.2 1.7 4.8 5\"/></g></svg>Partidos</a><a href=\"#\"><svg viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linejoin=\"round\"><rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15.5\" rx=\"2\"/><path d=\"M3.5 10h17M8 3v4M16 3v4\" stroke-linecap=\"round\"/></g></svg>Semana</a></nav>",
      "css": ":host{--amarelo:#ffd60a;--tinta:#111111;--tinta-2:#3d3d3d;--papel:#ffffff;--papel-2:#f6f5f0;--linha:#dedbd0;--carimbo:#1e40af;--verde:#12803f;--vermelho:#c81e1e;font-family:Archivo,system-ui,sans-serif;}.ds-nav{background:var(--tinta);display:grid;grid-template-columns:repeat(4,1fr);height:64px}.ds-nav a{color:var(--papel);text-decoration:none;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:.82rem;font-weight:600}.ds-nav a svg{width:24px;height:24px}.ds-nav a[aria-current=page],.ds-nav a:hover{color:var(--amarelo)}.ds-nav a:focus-visible{outline:3px solid var(--amarelo);outline-offset:-3px}"
    }
