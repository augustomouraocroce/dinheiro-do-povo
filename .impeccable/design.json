      "html": "<div class=\"ds-topo\"><label class=\"ds-busca\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"M15.5 15.5 21 21\"/></g></svg><input type=\"search\" placeholder=\"Busque um nome ou partido\"></label></div>",
      "css": ":host{--amarelo:#ffd60a;--tinta:#111111;--tinta-2:#3d3d3d;--papel:#ffffff;--papel-2:#f6f5f0;--linha:#dedbd0;--carimbo:#1e40af;--verde:#12803f;--vermelho:#c81e1e;font-family:Archivo,system-ui,sans-serif;}.ds-topo{background:var(--tinta);padding:14px 24px}.ds-busca{display:flex;align-items:center;gap:10px;background:var(--papel);color:var(--tinta);border-radius:9px;padding:0 14px;height:50px;border:2px solid var(--papel)}.ds-busca:focus-within{border-color:var(--amarelo)}.ds-busca svg{width:1.2em;height:1.2em}.ds-busca input{border:0;outline:0;background:transparent;font:inherit;font-size:1.05rem;width:100%}"
