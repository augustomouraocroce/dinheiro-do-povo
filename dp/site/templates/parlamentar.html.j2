{% extends "base.html.j2" %}
{% import "componentes.html.j2" as c with context %}
{% block titulo %}{{ p.nome }} ({{ p.partido }}-{{ p.uf }}) · Dinheiro do Povo{% endblock %}
{% block descricao %}Quanto custa, como comparece e como vota {{ p.nome }}, {{ p.cargo|lower }} pelo {{ p.partido }}-{{ p.uf }}. Dados oficiais com fonte.{% endblock %}
{% block conteudo %}
<section class="heroi" aria-labelledby="t-nome">
  <div class="ladrilho pilha">
    <div class="heroi-cabeca">
      <img class="foto" src="{{ raiz }}fotos/{{ p.slug }}.jpg" alt="Foto oficial de {{ p.nome }}" width="360" height="480">
      <div class="heroi-info">
        <h1 id="t-nome">{{ p.nome }}</h1>
        <div class="linha">{{ c.partido_id(p.partido, raiz, logos) }}</div>
        <span>{{ p.cargo }} · {{ p.uf }}</span>
      </div>
    </div>
    {% if p.casa == "camara" and p.custo %}
    <div class="preco-bloco">
      <p class="rotulo-preco">Custo médio do mandato</p>
      {{ c.preco(p.custo.total) }}
      <p class="sob-preco">por mês</p>
      {{ c.carimbo("Fonte: Câmara dos Deputados", p.url ~ "?ano=" ~ ano, hero=True) }}
    </div>
    {% elif p.casa == "senado" %}
    <div class="preco-bloco">
      <p class="rotulo-preco">Cota parlamentar (CEAPS), média</p>
      {{ c.preco(p.ceaps_media) }}
      <p class="sob-preco">por mês</p>
      {{ c.carimbo("Fonte: Senado Federal", refs_senado_ceaps, hero=True) }}
    </div>
    {% endif %}
  </div>

  <div class="pilha no-amarelo">
  {% if p.casa == "camara" and p.custo %}
    <h2>Esse custo mensal equivale a:</h2>
    {{ c.equivalencias(p.custo.total, refs, ["salario_minimo", "cesta_basica", "passagem_aerea", "m2_apartamento"]) }}
  {% elif p.casa == "senado" %}
    <h2>Essa cota mensal equivale a:</h2>
    {{ c.equivalencias(p.ceaps_media, refs, ["salario_minimo", "cesta_basica", "passagem_aerea", "m2_apartamento"]) }}
  {% endif %}
  </div>
</section>

{% if p.casa == "camara" and p.custo %}
<section class="secao" aria-labelledby="t-custo">
  <div class="ladrilho pilha">
    <h2 id="t-custo">De onde vem esse custo</h2>
    <p>Comparado com a média dos {{ camara.total }} deputados e com um salário mínimo, na mesma escala.</p>
    {{ c.legenda_custo(partes_custo) }}
    {{ grafico_custo|safe }}
    {{ c.tabela_custo(linhas_custo) }}
    <div class="linha">{{ c.ev("calculo", "salário + médias mensais de cota e verba (jan a " ~ meses[mes_corte - 1] ~ ") + auxílio-moradia ÷ " ~ mes_atual ~ " meses") }}</div>
  </div>
  {% set r = p.recursos %}
  {% set sal, cota, sobra, verba = r.get("salario_bruto_mensal"), r.get("cota_gasto"), r.get("cota_nao_utilizado"), r.get("verba_gabinete_gasto") %}
  {% set imovel, pessoal = r.get("imovel_funcional"), r.get("pessoal_gabinete") %}
  <div class="ladrilho pilha">
    <h3>Em {{ ano }}, segundo a página oficial</h3>
    <table class="tabela tabela-ficha">
      <tbody>
        <tr><th scope="row">Salário bruto mensal</th><td class="t">{{ sal.valor|brl if sal else "—" }}{% if sal %}{{ c.sm(sal.valor) }}{% endif %}</td></tr>
        <tr><th scope="row">Cota parlamentar usada no ano</th><td class="t">{{ cota.valor|brl if cota else "—" }}{% if cota %}{{ c.sm(cota.valor) }}{% endif %}{% if cota and sobra and (cota.valor + sobra.valor) %}<span class="sm">{{ (cota.valor / (cota.valor + sobra.valor))|pct }} do limite</span>{% endif %}</td></tr>
        <tr><th scope="row">Verba de gabinete usada no ano</th><td class="t">{{ verba.valor|brl if verba else "—" }}{% if verba %}{{ c.sm(verba.valor) }}{% endif %}</td></tr>
        <tr><th scope="row">Auxílio-moradia no ano</th><td class="t">{{ p.custo.auxilio_ano|brl }}{{ c.sm(p.custo.auxilio_ano) }}</td></tr>
        <tr><th scope="row">Imóvel funcional</th><td class="t">{{ imovel.texto if imovel else "—" }}</td></tr>
        <tr><th scope="row">Pessoal de gabinete</th><td class="t">{{ pessoal.texto if pessoal else "—" }}</td></tr>
      </tbody>
    </table>
    <div class="linha">{{ c.carimbo("Fonte: página do deputado", p.url ~ "?ano=" ~ ano) }}{% if camara.atualizado %}<span class="ev">atualizada pela Câmara em {{ camara.atualizado }}</span>{% endif %}</div>
  </div>
  <div class="ladrilho pilha">
    <h3>Cota parlamentar, mês a mês</h3>
    <div class="legenda" aria-hidden="true"><span><i style="background: var(--s-cota)"></i>Mês consolidado</span><span><i class="hachura"></i>Ainda pode aumentar (notas entram em até 90 dias)</span></div>
    {{ grafico_cota|safe }}
    <details class="tabela-dados"><summary><svg class="chev" aria-hidden="true"><use href="#i-seta"/></svg>Ver em tabela</summary><table class="tabela"><tbody>
      {% for m, v in p.custo.cota_serie|dictsort %}<tr><th scope="row">{{ meses[m - 1] }}</th><td class="n">{{ v|brl }}</td></tr>{% endfor %}
    </tbody></table></details>
  </div>
</section>

<section class="secao" aria-labelledby="t-presenca">
  <div class="ladrilho pilha">
    <h2 id="t-presenca">Presença no Plenário em {{ ano }}</h2>
    {% if p.presenca %}
      <p>Cada marca é um dia de sessão deliberativa. Presença em <strong>{{ p.presenca.pct_presente|pct }}</strong> dos dias; a média da Câmara é {{ camara.presenca.pct_presente|pct }}.</p>
      {{ c.marcas_presenca(p.presenca, meses) }}
      {{ c.carimbo("Fonte: Presença em Plenário, Câmara", p.presenca.url) }}
    {% else %}
      <p>Sem registro de presença em {{ ano }}.</p>
    {% endif %}
  </div>
</section>
{% endif %}

{% if p.casa == "senado" %}
<section class="secao" aria-labelledby="t-custo-sen">
  <div class="ladrilho pilha">
    <h2 id="t-custo-sen">Cota parlamentar (CEAPS), mês a mês</h2>
    <p>Em {{ ano }}, até agora: <strong>{{ p.ceaps_ano|brl }}</strong> ({{ (p.ceaps_ano / refs.salario_minimo.valor)|qtd }} salários mínimos). A média dos {{ senado.total }} senadores é {{ senado.ceaps_media|brl }} por mês.</p>
    {{ grafico_cota|safe }}
    <p class="secundario">O Senado ainda não publica subsídio, verba de gabinete e benefícios num formato que dê para coletar; por isso aqui aparece só a cota.</p>
    {{ c.carimbo("Fonte: CEAPS, Senado Federal", refs_senado_ceaps) }}
  </div>
  {% if p.participacao %}{% set pc = p.participacao.contagem %}
  <div class="ladrilho pilha">
    <h3>Votações nominais em {{ ano }}</h3>
    <p>Votou em <strong>{{ p.participacao.pct_votou|pct }}</strong> das {{ p.participacao.registros }} votações nominais em que estava em exercício. Média do Senado: {{ senado.votacao.pct_votou|pct }}.</p>
    <div class="marcas-legenda">
      <span><svg aria-hidden="true"><use href="#m-presente"/></svg><b>{{ pc.votou }}</b> votou</span>
      <span><svg aria-hidden="true"><use href="#m-sem-voto"/></svg><b>{{ pc.presente_sem_voto }}</b> presente sem votar</span>
      <span><svg aria-hidden="true"><use href="#m-justificada"/></svg><b>{{ pc.ausencia_justificada }}</b> ausência justificada</span>
      <span><svg aria-hidden="true"><use href="#m-nao-justificada"/></svg><b>{{ pc.ausencia_nao_justificada }}</b> não compareceu</span>
    </div>
    {{ c.carimbo("Fonte: votações nominais, Senado", "https://legis.senado.leg.br/dadosabertos") }}
  </div>
  {% endif %}
</section>
{% endif %}

<section class="secao" aria-labelledby="t-votos">
  <div class="ladrilho pilha">
    <h2 id="t-votos">Votações nominais da semana</h2>
    <p class="secundario">De {{ inicio|data }} a {{ fim|data }}.</p>
    {% if p.votos %}
    <div class="votos">
      {% for v in p.votos %}
      <div class="voto">
        <span class="v {% if v.voto == 'Sim' %}v-sim{% elif not v.voto %}v-vazio{% endif %}">{{ v.voto|rotulo_voto }}</span>
        <p>{{ v.descricao }} <span class="secundario">({{ v.data|data }}{% if v.aprovada == 1 %}, aprovada{% elif v.aprovada == 0 %}, rejeitada{% endif %})</span>{% if v.url %} · <a href="{{ v.url }}" target="_blank" rel="noopener">fonte</a>{% endif %}</p>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p>Não houve votação nominal no Plenário nesta semana.</p>
    {% endif %}
  </div>
</section>

<section class="secao" aria-labelledby="t-patrimonio">
  <div class="ladrilho pilha">
    <h2 id="t-patrimonio">Patrimônio declarado ao TSE</h2>
    {% set pt = p.patrimonio %}
    {% if pt and pt.ultima %}
      <p>Na candidatura de {{ pt.ultima.ano_eleicao }} ({{ pt.ultima.cargo|lower }}), declarou <strong>{{ pt.ultima.total|brl }}</strong> em bens, o equivalente a <strong>{{ (pt.ultima.total / refs.salario_minimo.valor)|qtd }} salários mínimos</strong>.</p>
      {% if pt.declaracoes|length > 1 %}{{ grafico_patrimonio|safe }}{% endif %}
      {% if pt.tipos_ultima %}
      <details class="tabela-dados" open><summary><svg class="chev" aria-hidden="true"><use href="#i-seta"/></svg>Por tipo de bem ({{ pt.ultima.ano_eleicao }})</summary>
        <table class="tabela tabela-ficha"><tbody>
        {% for t in pt.tipos_ultima[:8] %}<tr><th scope="row">{{ t.tipo }}</th><td class="t">{{ t.valor|brl }}{{ c.sm(t.valor) }}</td></tr>{% endfor %}
        {% if pt.tipos_ultima|length > 8 %}<tr><th scope="row">Outros {{ pt.tipos_ultima|length - 8 }} tipos</th><td class="t">{{ pt.tipos_ultima[8:]|sum(attribute="valor")|brl }}{{ c.sm(pt.tipos_ultima[8:]|sum(attribute="valor")) }}</td></tr>{% endif %}
        </tbody></table>
      </details>
      {% endif %}
      <p class="secundario">É o valor que o próprio candidato declarou à Justiça Eleitoral, não o preço de mercado dos bens.</p>
      {{ c.carimbo("Fonte: TSE, bens de candidatos " ~ pt.ultima.ano_eleicao, pt.ultima.url_fonte) }}
    {% else %}
      <p>Não encontramos declaração de bens no TSE para esta pessoa.</p>
    {% endif %}
  </div>
</section>
{% endblock %}
