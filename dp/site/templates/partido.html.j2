{% extends "base.html.j2" %}
{% import "componentes.html.j2" as c with context %}
{% block titulo %}{{ pt.nome }} ({{ pt.sigla }}) · Dinheiro do Povo{% endblock %}
{% block descricao %}Quanto custam e como trabalham os parlamentares do {{ pt.sigla }}, com dados oficiais.{% endblock %}
{% block conteudo %}
<section class="ladrilho pilha" aria-labelledby="t-partido">
  <div class="linha">{{ c.partido_id(pt.sigla, raiz, logos, grande=True, com_link=False) }}</div>
  <h1 id="t-partido">{{ pt.nome }}</h1>
  <p>{{ pt.deputados }} {{ pt.deputados|plural("deputado federal", "deputados federais") }} e {{ pt.senadores }} {{ pt.senadores|plural("senador", "senadores") }} em exercício na data da coleta.</p>
  {% if pt.custo_medio %}
  <div class="preco-bloco">
    <p class="rotulo-preco">Custo médio de cada deputado do {{ pt.sigla }}</p>
    {{ c.preco(pt.custo_medio.total) }}
    <p class="sob-preco">por mês</p>
    {{ c.sm(pt.custo_medio.total) }}
    <p class="secundario">Média da Câmara inteira: {{ camara.media_custo.total|brl }} por mês.</p>
  </div>
  <div class="linha">{{ c.ev("calculo", "média calculada a partir das páginas oficiais") }}</div>
  {% endif %}
</section>

{% if pt.custo_medio %}
<section class="secao" aria-labelledby="t-comp">
  <div class="ladrilho pilha">
    <h2 id="t-comp">Composição do custo, ao lado da Câmara inteira</h2>
    {{ c.cada_100(pt.custo_medio, "um deputado do " ~ pt.sigla) }}
    <p class="secundario">Na mesma escala: a média do partido, a média da Câmara e um salário mínimo.</p>
    {{ grafico_custo|safe }}
    {{ c.tabela_custo(linhas_custo) }}
  </div>
  <div class="grade-2" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr))">
    <div class="ladrilho pilha">
      <h3>Presença no Plenário em {{ ano }}</h3>
      {{ grafico_presenca|safe }}
    </div>
    <div class="ladrilho pilha">
      <h3>Ausências sem justificativa em {{ ano }}</h3>
      {{ grafico_ausencias|safe }}
      <p class="secundario">Parte dos dias de sessão em que o deputado faltou sem justificativa.</p>
    </div>
  </div>
</section>
{% endif %}

<section class="secao" aria-labelledby="t-membros">
  <h2 id="t-membros">Parlamentares do {{ pt.sigla }}</h2>
  <label class="filtro"><svg class="ic" aria-hidden="true"><use href="#i-busca"/></svg><span class="visivel-leitor">Filtrar por nome ou estado</span>
    <input type="search" placeholder="Filtrar por nome ou estado" data-filtro="lista-membros" data-contador="n-membros"></label>
  <label class="cv-campo ordem-campo no-amarelo"><span>Ordenar por</span>
    <select data-ordenar="lista-membros" data-nota="nota-ordem">
      <option value="nome">Nome (A a Z)</option>
      <option value="mais-gasta">Quem mais gasta</option>
      <option value="menos-gasta">Quem menos gasta</option>
      <option value="mais-faltas">Mais faltas sem justificativa</option>
      <option value="mais-presenca">Mais presença no Plenário</option>
      <option value="mais-projetos">Mais projetos apresentados</option>
      <option value="menos-projetos">Menos projetos apresentados</option>
      <option value="mais-casos">Mais processos e reportagens</option>
    </select>
  </label>
  <p class="secundario no-amarelo"><span id="n-membros">{{ pt.membros|length }}</span> parlamentares. <span id="nota-ordem">Valor de cada cartão: custo médio do mandato por mês (deputados) ou cota média por mês (senadores).</span></p>
  <div class="lista-pessoas" id="lista-membros">
    {% for p in pt.membros %}
      {% set pres = p.presenca if p.casa == "camara" else None %}
      {{ c.cartao_pessoa(p, raiz, (p.custo.total if p.casa == "camara" and p.custo else p.ceaps_media)|compacto ~ "/mês", {
           "nome": p.nome|normalizar,
           "gasto": (p.custo.total if p.casa == "camara" and p.custo else ""),
           "t-gasto": ((p.custo.total if p.casa == "camara" and p.custo else p.ceaps_media)|compacto ~ "/mês"),
           "faltas": (pres.contagem.ausencia_nao_justificada if pres else ""),
           "t-faltas": ((pres.contagem.ausencia_nao_justificada ~ " " ~ pres.contagem.ausencia_nao_justificada|plural("falta", "faltas")) if pres else "Senado: sem dado"),
           "presenca": (pres.pct_presente if pres and pres.pct_presente is not none else ""),
           "t-presenca": ((pres.pct_presente|pct ~ " presente") if pres and pres.pct_presente is not none else "Senado: sem dado"),
           "projetos": (p.projetos if p.projetos is not none else ""),
           "t-projetos": ((p.projetos ~ " " ~ p.projetos|plural("projeto", "projetos")) if p.projetos is not none else "Senado: sem dado"),
           "casos": p.casos|length,
           "t-casos": (p.casos|length ~ " " ~ p.casos|length|plural("caso", "casos")),
         }) }}
    {% endfor %}
  </div>
</section>
{% endblock %}
